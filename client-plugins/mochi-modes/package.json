{
  "name": "mochi-modes-client",
  "private": true,
  "version": "0.1.0",
  "description": "Mochi 教师场景：通用与四个专注场景，复用官方会话选择和默认设置。",
  "main": "index.mjs",
  "type": "module",
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-agent-preset",
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  },
  "exports": {
    ".": "./index.mjs",
    "./client": "./client.js"
  },
  "files": [
    "index.mjs",
    "client.js",
    "package.json"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  }
}
