{
  "name": "mochi-voice-chat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "index.mjs",
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-experimental-client-ui-voice-input",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
