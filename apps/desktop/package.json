  "build": {
    "appId": "cn.jiaxinglian.mochi",
    "productName": "Mochi",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "verifyUpdateCodeSignature": false
    },
    "dmg": {
      "sign": false,
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "${productName}-Setup-${version}-win-${arch}.${ext}"
    },
    "npmRebuild": true,
    "nativeRebuilder": "sequential",
    "asar": true,
    "asarUnpack": [
      "node_modules/**/*"
    ],
    "beforePack": "./scripts/prepare-mochi-resources.cjs",
    "extraResources": [
      {
        "from": ".mochi-package-resources-v1.nosync",
        "to": "mochi"
      }
    ],
    "compression": "maximum"
  }
}
