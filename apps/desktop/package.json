  "name": "mochi-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Mochi — 嘉行联 · 教师办公 AI Work Agent（桌面版）",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -p tsconfig.node.json",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.node.json --noEmit",
    "test:profile-skills": "node scripts/test-profile-skills.mjs",
    "test:runtime-profile": "node scripts/test-runtime-profile.mjs",
    "test:web-host-runtime": "npm run build && node scripts/test-web-host-runtime.mjs",
    "prepare:mochi-resources": "node scripts/prepare-mochi-resources.cjs",
    "test:package-resources": "node scripts/test-package-resources.mjs",
    "prepare:release-input": "node scripts/prepare-release-input.cjs",
    "test:dsh-host-peers": "node scripts/test-dsh-host-peers.mjs",
    "test:release-input": "node scripts/test-release-input.mjs",
    "test:installer-config": "node scripts/test-installer-config.mjs",
    "smoke": "MOCHI_DESKTOP_SMOKE=1 node scripts/dev.mjs",
    "dist:dir": "node scripts/package-desktop.cjs --target current --dir",
    "dist:mac": "node scripts/package-desktop.cjs --target mac --arch arm64",
    "dist:mac:arm64": "node scripts/package-desktop.cjs --target mac --arch arm64",
    "dist:mac:x64": "node scripts/package-desktop.cjs --target mac --arch x64",
    "dist:win": "node scripts/package-desktop.cjs --target win --arch x64",
    "dist:win:x64": "node scripts/package-desktop.cjs --target win --arch x64",
    "dist": "node scripts/package-desktop.cjs --target current"
  },
