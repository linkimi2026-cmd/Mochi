{
  "schemaVersion": 1,
  "serviceDefaults": {
    "campusApiUrl": "https://jyl-campus-health-entry.pages.dev",
    "searxngEndpoint": null
  },
  "profiles": {
    "headless": {
      "bundles": [
        "@deepseek-ai/dsh-base",
        "@deepseek-ai/dsh-headless"
      ],
      "templates": [
        "patches/core.patch.yml",
        "patches/headless.patch.yml"
      ],
      "plugins": [
        "mochi-hello",
        "mochi-dispatch",
        "mochi-campus",
        "mochi-web-search",
        "mochi-knowledge",
        "mochi-llm-mimo",
        "mochi-grades",
        "mochi-presentations",
        "mochi-documents",
        "mochi-files",
        "mochi-sheets",
        "mochi-visuals",
        "mochi-modeling",
        "mochi-memory",
        "mochi-task-scheduler"
      ]
    },
    "mochi": {
      "bundles": [
        "@deepseek-ai/dsh-base",
        "@deepseek-ai/dsh-headless"
      ],
      "templates": [
        "patches/core.patch.yml",
        "patches/headless.patch.yml"
      ],
      "plugins": [
        "mochi-hello",
        "mochi-dispatch",
        "mochi-campus",
        "mochi-web-search",
        "mochi-knowledge",
        "mochi-llm-mimo",
        "mochi-grades",
        "mochi-presentations",
        "mochi-documents",
        "mochi-files",
        "mochi-sheets",
        "mochi-visuals",
        "mochi-modeling",
        "mochi-memory",
        "mochi-task-scheduler",
        "mochi-modes",
        "mochi-approval"
      ]
    },
    "mochi-web": {
      "bundles": [
        "@deepseek-ai/dsh-base",
        "@deepseek-ai/dsh-web-app"
      ],
      "templates": [
        "patches/core.patch.yml",
        "patches/web.patch.yml"
      ],
      "plugins": [
        "mochi-hello",
        "mochi-dispatch",
        "mochi-campus",
        "mochi-web-search",
        "mochi-knowledge",
        "mochi-llm-mimo",
        "mochi-grades",
        "mochi-presentations",
        "mochi-documents",
        "mochi-files",
        "mochi-sheets",
        "mochi-visuals",
        "mochi-modeling",
        "mochi-memory",
        "mochi-task-scheduler",
        "mochi-modes",
        "mochi-modes-client",
        "jxl-theme",
        "jxl-brand",
        "jxl-campus",
        "mochi-model-presets",
        "dsh-better-sidebar",
        "mochi-lan",
        "mochi-lan-client"
      ]
    }
  },
  "roleProfiles": {
    "teacher": {
      "defaultPreset": "lesson-planning",
      "managedPreset": {
        "workspacePath": "client-plugins/teacher-agent-presets",
        "resourcePath": "teacher-agent-presets"
      },
      "includeInstalledPresetRoot": true,
      "includeUserPresetRoot": true
    },
    "classroom": {
      "defaultPreset": "classroom",
      "managedPreset": {
        "profilePath": "classroom-agent-presets"
      },
      "includeInstalledPresetRoot": false,
      "includeUserPresetRoot": false,
      "profilePlugins": {
        "headless": [
          "mochi-hello",
          "mochi-llm-mimo",
          "mochi-knowledge"
        ],
        "mochi": [
          "mochi-hello",
          "mochi-llm-mimo",
          "mochi-knowledge",
          "mochi-approval"
        ],
        "mochi-web": [
          "mochi-hello",
          "mochi-llm-mimo",
          "mochi-knowledge",
          "jxl-theme",
          "jxl-brand",
          "mochi-lan",
          "mochi-lan-client"
        ]
      }
    }
  },
  "plugins": {
    "mochi-hello": {
      "workspacePath": "plugins/mochi-hello",
      "resourcePath": "mochi-hello"
    },
    "mochi-dispatch": {
      "workspacePath": "plugins/mochi-dispatch",
      "resourcePath": "mochi-dispatch"
    },
    "mochi-campus": {
      "workspacePath": "plugins/mochi-campus",
      "resourcePath": "mochi-campus"
    },
    "mochi-web-search": {
      "workspacePath": "plugins/mochi-web-search",
      "resourcePath": "mochi-web-search"
    },
    "mochi-knowledge": {
      "workspacePath": "plugins/mochi-knowledge",
      "resourcePath": "mochi-knowledge"
    },
    "mochi-grades": {
      "workspacePath": "plugins/mochi-grades",
      "resourcePath": "mochi-grades"
    },
    "mochi-presentations": {
      "workspacePath": "plugins/mochi-presentations",
      "resourcePath": "mochi-presentations"
    },
    "mochi-documents": {
      "workspacePath": "plugins/mochi-documents",
      "resourcePath": "mochi-documents"
    },
    "mochi-files": {
      "workspacePath": "plugins/mochi-files",
      "resourcePath": "mochi-files"
    },
    "mochi-sheets": {
      "workspacePath": "plugins/mochi-sheets",
      "resourcePath": "mochi-sheets"
    },
    "mochi-visuals": {
      "workspacePath": "plugins/mochi-visuals",
      "resourcePath": "mochi-visuals"
    },
    "mochi-modes": {
      "workspacePath": "plugins/mochi-modes",
      "resourcePath": "mochi-modes"
    },
    "mochi-modes-client": {
      "workspacePath": "client-plugins/mochi-modes",
      "resourcePath": "mochi-modes-client"
    },
    "mochi-modeling": {
      "workspacePath": "plugins/mochi-modeling",
      "resourcePath": "mochi-modeling"
    },
    "mochi-memory": {
      "workspacePath": "plugins/mochi-memory",
      "resourcePath": "mochi-memory"
    },
    "mochi-task-scheduler": {
      "workspacePath": "plugins/mochi-task-scheduler",
      "resourcePath": "mochi-task-scheduler"
    },
    "mochi-llm-mimo": {
      "workspacePath": "plugins/mochi-llm-mimo",
      "resourcePath": "mochi-llm-mimo",
      "initialConfig": {
        "apiKeyEnv": "MIMO_API_KEY",
        "baseURL": "https://mimo.ezlook.top/v1",
        "reasoningEffort": "low",
        "models": [
          {
            "id": "mimo-v2.5",
            "contextWindow": 131072,
            "maxTokens": 8192,
            "inputModalities": [
              "text",
              "image"
            ],
            "reasoningEfforts": [
              "off",
              "low",
              "medium",
              "high"
            ]
          },
          {
            "id": "mimo-v2.5-pro",
            "contextWindow": 131072,
            "maxTokens": 8192,
            "inputModalities": [
              "text",
              "image"
            ],
            "reasoningEfforts": [
              "off",
              "low",
              "medium",
              "high"
            ]
          }
        ]
      }
    },
    "mochi-approval": {
      "workspacePath": "apps/desktop/electron/dsh/mochi-approval",
      "resourcePath": "mochi-approval"
    },
    "jxl-theme": {
      "workspacePath": "client-plugins/jxl-theme",
      "resourcePath": "jxl-theme"
    },
    "jxl-brand": {
      "workspacePath": "client-plugins/jxl-brand",
      "resourcePath": "jxl-brand"
    },
    "jxl-campus": {
      "workspacePath": "client-plugins/jxl-campus",
      "resourcePath": "jxl-campus"
    },
    "mochi-model-presets": {
      "workspacePath": "client-plugins/mochi-model-presets",
      "resourcePath": "mochi-model-presets"
    },
    "mochi-lan": {
      "workspacePath": "plugins/mochi-lan",
      "resourcePath": "mochi-lan"
    },
    "mochi-lan-client": {
      "workspacePath": "client-plugins/mochi-lan",
      "resourcePath": "mochi-lan-client"
    },
    "dsh-better-sidebar": {
      "workspacePath": "plugins/dsh-better-sidebar",
      "resourcePath": "dsh-better-sidebar"
    }
  }
}
