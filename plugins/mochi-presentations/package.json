{
  "name": "mochi-presentations",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "plugin.mjs",
  "description": "Mochi structured lesson-plan PPTX and same-input pure-JS PDF production",
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-tool"
      ]
    }
  },
  "exports": {
    ".": "./plugin.mjs",
    "./client": "./client.js"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@mochi/pdf-layout": "0.1.0",
    "@napi-rs/canvas": "1.0.8",
    "jszip": "3.10.1",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.3.289",
    "pptxgenjs": "4.0.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "0.1.3-alpha.1 || 0.2.0-rc.2"
  }
}
