<Slide style={{ width: 1280, height: 720, background: '#16211d', position: 'relative', overflow: 'hidden' }}>

    {/* A 区 · 标题块 */}
    <Box style={{ height: 120, paddingLeft: 96, paddingRight: 96, paddingTop: 20, justifyContent: 'center' }}>
        <Text style={{ fontSize: 36, fontWeight: 'bold', color: '#f5f2e9' }}>Mochi 是什么</Text>
    </Box>

    {/* B 区 · 内容区 */}
    <Box style={{
        height: 540, paddingLeft: 96, paddingRight: 96,
        flexDirection: 'row', gap: 48, alignItems: 'center',
    }}>

        {/* 左大图 58% */}
        <Box style={{ flexDirection: 'column', gap: 14 }}>
            <Box style={{
                width: 624, height: 330,
                borderRadius: 12, overflow: 'hidden',
                border: '1px solid rgba(245,242,233,0.14)',
                boxShadow: '0 8px 32px rgba(0,0,0,0.35)',
            }}>
                <Image src="assets/ui-commands.png" style={{ width: 624, height: 330, objectFit: 'cover' }} />
            </Box>
            <Text style={{ fontSize: 14, color: 'rgba(245,242,233,0.4)' }}>
                真实界面：在输入框里用指令唤起 Mochi 的能力
            </Text>
        </Box>

        {/* 右侧文字 */}
        <Box style={{ flex: 1, flexDirection: 'column', gap: 18 }}>

            <Box style={{ flexDirection: 'row', gap: 14, alignItems: 'flex-start' }}>
                <Box style={{ width: 8, height: 8, borderRadius: 4, background: '#e8b34b', marginTop: 9 }} />
                <Box style={{ flex: 1, flexDirection: 'column', gap: 5 }}>
                    <Text style={{ fontSize: 20, fontWeight: 600, color: '#f5f2e9' }}>它是老师桌面上的一个 App</Text>
                    <Text style={{ fontSize: 15, color: 'rgba(245,242,233,0.5)', lineHeight: 1.65 }}>双击就打开，不需要装开发环境，不需要开终端</Text>
                </Box>
            </Box>

            <Box style={{ flexDirection: 'row', gap: 14, alignItems: 'flex-start' }}>
                <Box style={{ width: 8, height: 8, borderRadius: 4, background: '#e8b34b', marginTop: 9 }} />
                <Box style={{ flex: 1, flexDirection: 'column', gap: 5 }}>
                    <Text style={{ fontSize: 20, fontWeight: 600, color: '#f5f2e9' }}>它会调用校园系统里的真实工具</Text>
                    <Text style={{ fontSize: 15, color: 'rgba(245,242,233,0.5)', lineHeight: 1.65 }}>查学生状态、开流动单、发通知——不是在对话里"模拟"一遍</Text>
                </Box>
            </Box>

            <Box style={{ flexDirection: 'row', gap: 14, alignItems: 'flex-start' }}>
                <Box style={{ width: 8, height: 8, borderRadius: 4, background: '#e8b34b', marginTop: 9 }} />
                <Box style={{ flex: 1, flexDirection: 'column', gap: 5 }}>
                    <Text style={{ fontSize: 20, fontWeight: 600, color: '#f5f2e9' }}>敏感操作必须老师点确认</Text>
                    <Text style={{ fontSize: 15, color: 'rgba(245,242,233,0.5)', lineHeight: 1.65 }}>AI 可以提议，但最终由人拍板——每一步都留痕</Text>
                </Box>
            </Box>

            <Box style={{ height: 1, background: 'rgba(245,242,233,0.12)', marginTop: 2 }} />

            <Text style={{ fontSize: 16, color: '#e8b34b', lineHeight: 1.75 }}>
                所以关键不是"它能聊天"，而是"它能办事，并且有人把关"。
            </Text>

        </Box>
    </Box>

    {/* C 区 · 页脚条 */}
    <Box style={{
        position: 'absolute', bottom: 0, left: 0, width: 1280, height: 60,
        paddingLeft: 96, paddingRight: 96,
        flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between',
    }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
            <Box style={{ width: 10, height: 10, borderRadius: 5, background: '#e8b34b' }} />
            <Text style={{ fontSize: 14, color: 'rgba(245,242,233,0.45)' }}>Mochi · 嘉祥教育集团 AI 创意实践大赛</Text>
        </Box>
        <Text style={{ fontSize: 14, color: 'rgba(245,242,233,0.45)' }}>06 / 17</Text>
    </Box>
</Slide>
