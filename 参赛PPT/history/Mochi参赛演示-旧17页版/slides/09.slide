        }}>
            <Image src="assets/ui-workbench.png" style={{ width: 1088, height: 296, objectFit: 'cover' }} />
        </Box>

        {/* 下半：三张非等宽卡片 */}
        <Box style={{ flex: 1, flexDirection: 'row', gap: 20 }}>

            <Box style={{
                flex: 1.25, flexDirection: 'column', gap: 10,
                background: 'rgba(245,242,233,0.05)',
                border: '1px solid rgba(245,242,233,0.12)',
                borderRadius: 10, padding: 20,
            }}>
                <Text style={{ fontSize: 20, fontWeight: 600, color: '#f5f2e9' }}>本地知识库</Text>
                <Text style={{ fontSize: 15, color: 'rgba(245,242,233,0.55)', lineHeight: 1.7 }}>
                    33 册教材导入本机，按页检索。老师问"这个知识点在哪一册哪一页"，它直接给到页码；公式与图表会提醒核对原页，绝不编造原文。
                </Text>
            </Box>

            <Box style={{
                flex: 1, flexDirection: 'column', gap: 10,
                background: 'rgba(245,242,233,0.05)',
                border: '1px solid rgba(245,242,233,0.12)',
                borderRadius: 10, padding: 20,
            }}>
                <Text style={{ fontSize: 20, fontWeight: 600, color: '#f5f2e9' }}>记忆</Text>
                <Text style={{ fontSize: 15, color: 'rgba(245,242,233,0.55)', lineHeight: 1.7 }}>
                    记住老师的工作习惯与明确要求，下次自动带出来。老师能查看、能纠正、能一键清空——记忆不是黑箱，也绝不偷偷记学生明细。
                </Text>
            </Box>

            <Box style={{
                flex: 0.85, flexDirection: 'column', gap: 10,
                background: 'rgba(245,242,233,0.05)',
                border: '1px solid rgba(245,242,233,0.12)',
